{
  "name": "sqrail-site",
  "version": "0.3.1",
  "private": true,
  "description": "Validation and Cloudflare deployment tooling for the sqrail documentation site",
  "scripts": {
    "format": "prettier --write .htmlvalidate.json package.json \"*.md\" \"docs/*.md\" \"benchmarks/*.md\" \"benchmarks/agent-eval/*.md\" \".github/**/*.md\" \".github/**/*.yml\" \"site/**/*.html\" site/styles.css site/app.js wrangler.jsonc",
    "format:check": "prettier --check .htmlvalidate.json package.json \"*.md\" \"docs/*.md\" \"benchmarks/*.md\" \"benchmarks/agent-eval/*.md\" \".github/**/*.md\" \".github/**/*.yml\" \"site/**/*.html\" site/styles.css site/app.js wrangler.jsonc",
    "site:html": "html-validate \"site/**/*.html\"",
    "site:js": "node --check site/app.js",
    "site:check": "npm run format:check && npm run site:html && npm run site:js && npm run cloudflare:check",
    "cloudflare:check": "wrangler deploy --dry-run",
    "deploy:cloudflare": "wrangler deploy"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents": false,
    "workerd@1.20260722.1": true
  },
  "devDependencies": {
    "html-validate": "11.6.0",
    "prettier": "3.9.6",
    "wrangler": "4.115.0"
  }
}
