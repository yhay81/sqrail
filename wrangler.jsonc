{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sqrails",
  "compatibility_date": "2026-07-28",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "sqrails.yhay81.com",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
}
